@model Q_Manage.Models.Proyecto
@{
    ViewData["Title"] = "Detalles del Proyecto";
}

<div class="container mt-4 d-flex justify-content-center">
    <div class="card bg-dark text-light p-4 shadow-lg" style="width: 40rem;">
        <div class="card-header text-center">
            <h2>📂 Proyecto: @Model.Nombre</h2>
        </div>

        <div class="card-body">
            <p><strong>📝 Descripción:</strong> @Model.Descripcion</p>
            <p><strong>📅 Inicio:</strong> @Model.FechaInicio.ToString("dd/MM/yyyy")</p>
            <p><strong>📅 Finalización:</strong> @(Model.FechaFinalizacion?.ToString("dd/MM/yyyy") ?? "N/A")</p>
            <p><strong>💰 Estado de Pago:</strong> @Model.EstadoPago.Nombre</p>
            <p><strong>🛠 Estado del Proyecto:</strong> @Model.EstadoProyecto.Nombre</p>

            <div class="text-center">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">✏️ Editar</a>
                <a asp-action="Index" class="btn btn-secondary">↩️ Volver</a>
            </div>
        </div>
    </div>
</div>

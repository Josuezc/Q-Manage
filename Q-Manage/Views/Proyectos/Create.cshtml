@model Q_Manage.Models.Proyecto

@{
    ViewData["Title"] = "Crear Proyecto";
}

<div class="container mt-4 d-flex justify-content-center">
    <div class="card bg-dark text-light p-4 shadow-lg" style="width: 40rem;">
        <div class="card-header text-center">
            <h2>📂 Crear Proyecto</h2>
        </div>

        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">📌 Nombre</label>
                    <input asp-for="Nombre" class="form-control bg-dark text-light border-secondary" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label">📝 Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control bg-dark text-light border-secondary" required></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaInicio" class="form-label">📅 Fecha de Inicio</label>
                    <input asp-for="FechaInicio" type="date" class="form-control bg-dark text-light border-secondary" required />
                </div>

                <div class="mb-3">
                    <label asp-for="FechaFinalizacion" class="form-label">📅 Fecha de Finalización (opcional)</label>
                    <input asp-for="FechaFinalizacion" type="date" class="form-control bg-dark text-light border-secondary" />
                </div>

                <div class="mb-3">
                    <label class="form-label">💰 Estado de Pago</label>
                    <select asp-for="EstadoPagoId" class="form-select bg-dark text-light border-secondary">
                        @foreach (var pago in ViewBag.EstadosPago)
                        {
                            <option value="@pago.Id">@pago.Nombre</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">🛠 Estado del Proyecto</label>
                    <select asp-for="EstadoProyectoId" class="form-select bg-dark text-light border-secondary">
                        @foreach (var estado in ViewBag.EstadosProyecto)
                        {
                            <option value="@estado.Id">@estado.Nombre</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">👤 Seleccionar Cliente</label>

                    @if (ViewBag.Clientes == null || !((List<ApplicationUser>)ViewBag.Clientes).Any())
                    {
                        <div class="alert alert-warning text-dark">
                            ⚠️ No hay clientes disponibles. Asegúrate de que hay usuarios con el rol "Client".
                        </div>
                    }
                    else
                    {
                        <select asp-for="UsuarioId" class="form-select bg-dark text-light border-secondary" required>
                            <option value="">-- Seleccionar Cliente --</option>
                            @foreach (var cliente in ViewBag.Clientes)
                            {
                                <option value="@cliente.Id">@cliente.UserName - 📧 @cliente.Email</option>
                            }
                        </select>
                        <span asp-validation-for="UsuarioId" class="text-danger"></span>
                    }
                </div>


                <div class="text-center">
                    <button type="submit" class="btn btn-success">💾 Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">↩️ Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

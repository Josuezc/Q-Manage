@model Q_Manage.Models.Proyecto
@{
    ViewData["Title"] = "Eliminar Proyecto";
}

@if (TempData["ErrorEliminar"] != null)
{
    <div class="alert alert-danger text-center fw-bold">
        @TempData["ErrorEliminar"]
    </div>
}

<div class="container mt-4 d-flex justify-content-center">
    <div class="card bg-dark text-light p-4 shadow-lg" style="width: 40rem;">
        <div class="card-header text-center bg-danger">
            <h2>⚠️ Eliminar Proyecto</h2>
        </div>

        <div class="card-body">
            <p class="text-center">
                ¿Estás seguro de que deseas eliminar el proyecto <strong>@Model.Nombre</strong>?
            </p>
            <p class="text-center mt-3 text-warning">
                ⚠️ Si el proyecto tiene pagos o comentarios relacionados, eliminálos antes de continuar.
            </p>


            <ul class="list-group list-group-flush">
                <li class="list-group-item bg-dark border-secondary text-white">
                    <strong>📌 Nombre:</strong> @Model.Nombre
                </li>
                <li class="list-group-item bg-dark border-secondary text-white">
                    <strong>📝 Descripción:</strong> @Model.Descripcion
                </li>
                <li class="list-group-item bg-dark border-secondary text-white">
                    <strong>📅 Fecha Inicio:</strong> @Model.FechaInicio.ToString("dd/MM/yyyy")
                </li>
                <li class="list-group-item bg-dark border-secondary text-white">
                    <strong>📅 Fecha Finalización:</strong> @(Model.FechaFinalizacion?.ToString("dd/MM/yyyy") ?? "N/A")
                </li>
                <li class="list-group-item bg-dark border-secondary text-white">
                    <strong>💰 Estado de Pago:</strong> @Model.EstadoPago.Nombre
                </li>
                <li class="list-group-item bg-dark border-secondary text-white">
                    <strong>🛠 Estado del Proyecto:</strong> @Model.EstadoProyecto.Nombre
                </li>
            </ul>

            <div class="text-center mt-3">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">🗑️ Confirmar Eliminación</button>
                    <a asp-action="Index" class="btn btn-secondary">↩️ Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>

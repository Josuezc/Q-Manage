@model IEnumerable<Q_Manage.Models.Proyecto>

@{
    ViewData["Title"] = "Proyectos";
}

<div class="container mt-4">
    <h2 class="text-white text-center">📂 Gestión de Proyectos</h2>
      @if (User.IsInRole("Admin"))
                        {
    <div class="text-end mb-3">
        <a asp-action="Create" class="btn btn-success">➕ Nuevo Proyecto</a>
    </div>
                        }
    <div class="row">
        @foreach (var proyecto in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card bg-dark text-white shadow-lg">
                    
                    <div class="card-header bg-primary text-center fw-bold">
                        📌 @proyecto.Nombre
                    </div>
                    
                    <div class="card-body">
                        <p class="fw-bold"><i class="fas fa-align-left"></i> @proyecto.Descripcion</p>

                        <ul class="list-group list-group-flush">
                            <li class="list-group-item bg-dark border-secondary text-white d-flex justify-content-between">
                                <span><i class="fas fa-tools"></i> Estado:</span> 
                                <span class="badge bg-info text-dark">@proyecto.EstadoProyecto.Nombre</span>
                            </li>
                            <li class="list-group-item bg-dark border-secondary text-white d-flex justify-content-between">
                                <span><i class="fas fa-dollar-sign"></i> Pago:</span> 
                                <span class="badge @(proyecto.EstadoPagoId == 1 ? "bg-success text-dark" : proyecto.EstadoPagoId == 2 ? "bg-warning text-dark" : "bg-danger text-light")">
                                    @proyecto.EstadoPago.Nombre
                                </span>
                            </li>
                            <li class="list-group-item bg-dark border-secondary text-white d-flex justify-content-between">
                                <span><i class="fas fa-calendar-alt"></i> Inicio:</span> 
                                <span class="text-white">@proyecto.FechaInicio.ToString("dd/MM/yyyy")</span>
                            </li>
                            <li class="list-group-item bg-dark border-secondary text-white d-flex justify-content-between">
                                <span><i class="fas fa-calendar-check"></i> Finalización:</span> 
                                <span class="text-white">@(proyecto.FechaFinalizacion?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                            </li>
                            <li class="list-group-item bg-dark border-secondary text-white d-flex justify-content-between">
                                <span><i class="fas fa-user"></i> Cliente:</span>
                                @if (!string.IsNullOrEmpty(proyecto.UsuarioId))
                                {
                                    <span class="badge bg-light text-dark">@proyecto.Usuario.UserName</span>
                                }
                                else
                                {
                                    <span class="text-muted">No asignado</span>
                                }
                            </li>
                        </ul>

                        <div class="mt-3">
                            <p class="mb-1 fw-bold text-white"><i class="fas fa-chart-line"></i> Progreso: @proyecto.Progreso%</p>
                            <div class="progress">
                                <div class="progress-bar @(proyecto.Progreso < 50 ? "bg-danger" : proyecto.Progreso < 80 ? "bg-warning text-dark" : "bg-success text-dark")" 
                                     role="progressbar" 
                                     style="width: @proyecto.Progreso%;" 
                                     aria-valuenow="@proyecto.Progreso" aria-valuemin="0" aria-valuemax="100">
                                    @proyecto.Progreso%
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@proyecto.Id" class="btn btn-info btn-sm"><i class="fas fa-eye"></i> Ver</a>
                        @if (User.IsInRole("Admin"))
                        {
                           
                       
                        <a asp-action="Edit" asp-route-id="@proyecto.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Editar</a>
                        <a asp-action="Delete" asp-route-id="@proyecto.Id" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Eliminar</a>
                        }
                        <a asp-controller="Pagos" asp-action="Index" asp-route-proyectoId="@proyecto.Id" class="btn btn-secondary btn-sm">
                            Finanzas
                        </a>
                        <a asp-controller="Kanban" asp-action="Index" asp-route-proyectoId="@proyecto.Id" class="btn btn-info btn-sm">
                            Kanban
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


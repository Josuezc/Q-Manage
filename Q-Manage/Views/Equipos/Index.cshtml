@model IEnumerable<Q_Manage.Models.Equipo>

@{
    ViewData["Title"] = "Equipos";
}

<div class="container mt-4">
    <h2 class="text-white text-center">👥 Gestión de Equipos</h2>

    <div class="text-end mb-3">
        <a asp-action="Create" class="btn btn-success">➕ Nuevo Equipo</a>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            <div class="row">
                @foreach (var equipo in Model)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="card bg-dark text-white shadow-lg">

                            <!-- Encabezado -->
                            <div class="card-header bg-primary text-center fw-bold">
                                📌 @equipo.Name
                            </div>

                            <div class="card-body">
                                <p class="fw-bold"><i class="fas fa-align-left"></i> @equipo.Description</p>

                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item bg-dark border-secondary text-white d-flex justify-content-between">
                                        <span><i class="fas fa-users"></i> Miembros:</span>
                                        <span class="badge bg-info text-dark">@(equipo.empleadorPorEquipos?.Count ?? 0)</span>
                                    </li>
                                    <li class="list-group-item bg-dark border-secondary text-white d-flex justify-content-between">
                                        <span><i class="fas fa-folder"></i> Proyectos Asignados:</span>
                                        <span class="badge bg-warning text-dark">@(equipo.ProyectosPorEquipos?.Count ?? 0)</span>
                                    </li>
                                </ul>

                            </div>

                            <!-- Botones -->
                            <div class="card-footer d-flex justify-content-between">
                                <a asp-action="Details" asp-route-id="@equipo.Id" class="btn btn-info btn-sm"><i class="fas fa-eye"></i> Ver</a>
                                <a asp-action="Edit" asp-route-id="@equipo.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Editar</a>
                                <a asp-action="Delete" asp-route-id="@equipo.Id" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Eliminar</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning text-dark text-center">
                ⚠️ No hay equipos disponibles.
            </div>
        }

    </div>
</div>

@model Q_Manage.Models.Equipo

@{
    ViewData["Title"] = "Eliminar Equipo";
}

<div class="container mt-4 d-flex justify-content-center">
    <div class="card bg-dark text-light p-4 shadow-lg" style="width: 40rem;">

        <div class="card-body">
            <h4 class="text-danger text-center">⚠️ ¿Estás seguro de que deseas eliminar este equipo?</h4>
            <hr />

            <dl class="row">
                <dt class="col-sm-4">📌 Nombre</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-4">📝 Descripción</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>

                <dt class="col-sm-4">👥 Miembros del Equipo</dt>
                <dd class="col-sm-8">
                    @if (Model.empleadorPorEquipos.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var miembro in Model.empleadorPorEquipos)
                            {
                                <li>✔️ @miembro.Usuario.UserName</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">No hay miembros asignados.</span>
                    }
                </dd>

                <dt class="col-sm-4">📂 Proyectos Asignados</dt>
                <dd class="col-sm-8">
                    @if (Model.ProyectosPorEquipos?.Any() == true)
                    {
                        <ul class="list-unstyled">
                            @foreach (var proyecto in Model.ProyectosPorEquipos)
                            {
                                <li>📌 @proyecto.Proyecto.Nombre</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">No hay proyectos asignados.</span>
                    }
                </dd>

            </dl>

            <div class="text-center">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        ❌ Eliminar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        ↩️ Volver
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

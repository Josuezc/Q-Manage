@model Q_Manage.Models.Equipo

@{
    ViewData["Title"] = "Crear Equipo";
}

<h1>Crear Equipo</h1>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Seleccionar Miembros del Equipo:</label>
        <div>
            @foreach (var usuario in ViewBag.Usuarios)
            {
                <div class="form-check">
                    <input type="checkbox" name="UsuarioIds" value="@usuario.Id" class="form-check-input" />
                    <label class="form-check-label">@usuario.UserName</label>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

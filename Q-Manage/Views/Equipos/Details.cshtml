@model Q_Manage.Models.Equipo

@{
    ViewData["Title"] = "Detalles del Equipo";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 bg-dark text-light position-relative overflow-hidden">

        <div class="card-header text-white text-center position-relative">
            <h3 class="mb-0">
                Detalles del Equipo
            </h3>
        </div>

        <div class="card-body">
            <div class="row align-items-center">
                <!-- Imagen decorativa -->
                <div class="col-md-4 text-center">
                    <img src="~/img/equipo.png" alt="Imagen del equipo"
                         class="img-fluid rounded shadow-lg" />
                </div>

                <!-- Información del Equipo -->
                <div class="col-md-8">
                    <h5 class="text-light"><i class="bi bi-info-circle-fill"></i> Información del Equipo</h5>
                    <div class="p-3 rounded shadow-sm bg-gradient">
                        <ul class="list-group text-light">
                            <li class="list-group-item bg-transparent border-light text-light">
                                <strong>📌 Nombre:</strong> @Model.Name
                            </li>
                            <li class="list-group-item bg-transparent border-light text-light">
                                <strong>📝 Descripción:</strong> @Model.Description
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <hr class="bg-light">

            <h5 class="text-light"><i class="bi bi-people"></i> Miembros del Equipo</h5>
            @if (Model.empleadorPorEquipos != null && Model.empleadorPorEquipos.Any())
            {
                <ul class="list-group">
                    @foreach (var miembro in Model.empleadorPorEquipos)
                    {
                        <li class="list-group-item d-flex bg-dark text-light border border-light">
                            <i class="bi bi-person-fill text-primary me-2"></i> @miembro.Usuario.UserName
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="alert alert-warning mt-2">
                    <i class="bi bi-exclamation-circle-fill"></i> No hay miembros asignados.
                </div>
            }

            <hr class="bg-light">

            <h5><i class="bi bi-plus-circle"></i> Asignar Proyecto</h5>
            <form asp-action="AsignarProyecto" method="post" class="mt-3">
                <input type="hidden" name="equipoId" value="@Model.Id" />
                <div class="row">
                    <div class="col-md-8">
                        <select name="proyectoId" class="form-select bg-dark text-light border-light">
                            @foreach (var proyecto in ViewBag.ProyectosDisponibles as List<Q_Manage.Models.Proyecto>)
                            {
                                <option value="@proyecto.Id">@proyecto.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mt-1">
                        <button type="submit" class="btn btn-success h-100 w-50">
                            <i class="bi bi-check-circle"></i> Asignar
                        </button>
                    </div>
                </div>
            </form>

            <hr class="bg-light">

            <h5><i class="bi bi-clipboard-check"></i> Proyectos Asignados</h5>
            @if (Model.ProyectosPorEquipos != null && Model.ProyectosPorEquipos.Any())
            {
                <table class="table table-dark table-striped mt-2">
                    <thead class="table-primary">
                        <tr>
                            <th>📂 Proyecto</th>
                            <th>🛠 Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proyecto in Model.ProyectosPorEquipos)
                        {
                            <tr>
                                <td>@proyecto.Proyecto.Nombre</td>
                                <td>
                                    <form asp-action="DesasignarProyecto" method="post">
                                        <input type="hidden" name="equipoId" value="@Model.Id" />
                                        <input type="hidden" name="proyectoId" value="@proyecto.Proyecto.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-primary mt-2">
                    <i class="bi bi-exclamation-circle"></i> No hay proyectos asignados.
                </div>
            }
        </div>

        <div class="card-footer bg-dark border-top border-light d-flex justify-content-end gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning btn-sm">
                <i class="bi bi-pencil-square"></i> Editar
            </a>
            <a asp-action="Index" class="btn btn-info btn-sm">
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </a>
        </div>
    </div>
</div>

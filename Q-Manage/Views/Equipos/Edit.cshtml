@model Q_Manage.Models.Equipo

@{
    ViewData["Title"] = "Editar Equipo";
}

<div class="container mt-4 d-flex justify-content-center">
    <div class="card bg-dark text-light p-4 shadow-lg" style="width: 40rem;">
        <div class="card-header text-center">
            <h2>
                Editar Equipo
            </h2>
        </div>

        <div class="card-body">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">📌 Nombre del Equipo</label>
                    <input asp-for="Name" class="form-control bg-dark text-light border-secondary" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">📝 Descripción</label>
                    <input asp-for="Description" class="form-control bg-dark text-light border-secondary" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                <label class="form-label">👥 Seleccionar Miembros del Equipo</label>
                    <div class="border rounded p-2">
                            @foreach (var usuario in ViewBag.Usuarios)
                            {
                                bool esMiembro = Model.empleadorPorEquipos.Any(e => e.UsuarioId == usuario.Id);

                                <div class="form-check">
                                    <input type="checkbox" name="UsuarioIds" value="@usuario.Id" class="form-check-input"
                                                @(esMiembro ? "checked" : "") />
                                    <label class="form-check-label">@usuario.UserName</label>
                                </div>
                            }
                    </div>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-success">
                        💾 Guardar cambios
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        ↩️ Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

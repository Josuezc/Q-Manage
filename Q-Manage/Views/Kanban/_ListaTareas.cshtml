@model Q_Manage.Models.Kanban

<div class="row d-flex justify-content-center">
    @foreach (var estado in ViewBag.EstadosTarea as List<EstadoTarea>)
    {
        <div class="col-md-4">
            <div class="card bg-dark text-light shadow-lg">
                <div class="card-header bg-primary text-center fw-bold">
                    @estado.Nombre
                </div>
                <div class="card-body estado-tarea min-vh-50 p-3" data-estado-id="@estado.Id">
                    @{
                        var tareasEnEstado = Model.Tareas.Where(t => t.EstadoTareaId == estado.Id).ToList();
                    }

                    @if (tareasEnEstado.Any())
                    {
                        @foreach (var tarea in tareasEnEstado)
                        {
                            <div class="tarea-item p-2 mb-2 rounded bg-gradient text-light shadow-sm border-start border-4"
                                 data-id="@tarea.Id"
                                 style="border-color: @(tarea.PrioridadTarea.Nombre == "Alta" ? "red" : tarea.PrioridadTarea.Nombre == "Media" ? "orange" : "green");">

                                <h6 class="d-flex justify-content-between align-items-center">
                                    <a class="text-white text-decoration-none fw-bold" data-bs-toggle="collapse"
                                       href="#tarea-@tarea.Id" onclick="toggleDropdown(this)">
                                        <i class="dropdown-icon bi bi-chevron-down"></i> @tarea.Titulo
                                    </a>
                                </h6>

                                <div id="tarea-@tarea.Id" class="collapse">
                                    <p class="text-light">@tarea.Descripcion</p>
                                    <span class="badge bg-info">@tarea.PrioridadTarea.Nombre</span>

                                    <div class="mt-2">
                                        @if (User.IsInRole("Admin"))
                                        {
                                        <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editarTareaModal-@tarea.Id">
                                            ✏️ Editar
                                        </button>
                                       
                                        <button class="btn btn-danger btn-sm" onclick="eliminarTarea(@tarea.Id)">🗑️ Eliminar</button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="modal fade" id="editarTareaModal-@tarea.Id" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content bg-dark text-light">
                                        <div class="modal-header">
                                            <h5 class="modal-title">✏️ Editar Tarea</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="EditarTarea" method="post">
                                            <div class="modal-body">
                                                <input type="hidden" name="Id" value="@tarea.Id" />
                                                <input type="text" name="Titulo" class="form-control mb-2 text-white bg-secondary border-0" value="@tarea.Titulo" required />
                                                <textarea name="Descripcion" class="form-control mb-2 text-white bg-secondary border-0">@tarea.Descripcion</textarea>
                                                <select name="EstadoTareaId" class="form-select mb-2">
                                                    @foreach (var estadoTarea in ViewBag.EstadosTarea as List<EstadoTarea>)
                                                    {
                                                        <option value="@estadoTarea.Id" selected="@(estadoTarea.Id == tarea.EstadoTareaId)"> @estadoTarea.Nombre</option>
                                                    }
                                                </select>
                                                <select name="PrioridadTareaId" class="form-select">
                                                    @foreach (var prioridad in ViewBag.PrioridadesTarea as List<PrioridadTarea>)
                                                    {
                                                        <option value="@prioridad.Id" selected="@(prioridad.Id == tarea.PrioridadTareaId)"> @prioridad.Nombre</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="submit" class="btn btn-warning">💾 Guardar Cambios</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

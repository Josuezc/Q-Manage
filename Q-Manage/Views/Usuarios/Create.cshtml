@model Q_Manage.Models.ApplicationUser

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="container mt-4 d-flex justify-content-center">
    <div class="card bg-dark text-light p-4 shadow-lg" style="width: 40rem;">
        <div class="card-header text-center">
            <h2>👤 Crear Usuario</h2>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label for="Email" class="form-label">📧 Email</label>
                    <input asp-for="Email" class="form-control bg-dark text-light border-secondary" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="UserName" class="form-label">📧 Confirmar Email</label>
                    <input asp-for="UserName" class="form-control bg-dark text-light border-secondary" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">🔒 Contraseña</label>
                    <input type="password" name="password" class="form-control bg-dark text-light border-secondary" />
                    <span class="text-danger">@ViewData["PasswordError"]</span>
                </div>

                <div class="mb-3">
                    <label class="form-label">👥 Rol del Usuario</label>
                    <select name="roleUser" class="form-select bg-dark text-light border-secondary">
                        @foreach (var role in ViewData["Roles"] as SelectList)
                        {
                            <option value="@role.Value">@role.Text</option>
                        }
                    </select>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary px-4">💾 Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2 px-4">↩️ Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

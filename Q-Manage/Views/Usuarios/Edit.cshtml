@model Q_Manage.Models.ApplicationUser

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-4 d-flex justify-content-center">
    <div class="card bg-dark text-light p-4 shadow-lg" style="width: 40rem;">
        <div class="card-header text-center">
            <h2>✏️ Editar Usuario</h2>
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserName" class="form-control" id="usernameInput" />

                @if (User.IsInRole("Admin"))
                {
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">📧 Correo Electrónico</label>
                        <input asp-for="Email" class="form-control bg-dark text-light border-secondary" required id="emailInput" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                }
                @if (User.IsInRole("User"))
                {
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">📧 Correo Electrónico</label>
                        <input asp-for="Email" class="form-control bg-dark text-light border-secondary" readonly id="emailInput" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">¿Correo Electrónico Confirmado?</label>
                    <div>
                        <label>
                            <input type="radio" name="emailConfi" value="true" @(Model.EmailConfirmed ? "checked" : "") /> Sí
                        </label>
                        <label class="ms-3">
                            <input type="radio" name="emailConfi" value="false" @(!Model.EmailConfirmed ? "checked" : "") /> No
                        </label>
                    </div>
                    <span asp-validation-for="EmailConfirmed" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="phoneInput" class="form-label">Teléfono</label>
                    <input asp-for="PhoneNumber" name="phone" class="form-control bg-dark text-light border-secondary" id="phoneInput" />
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="mb-3">
                        <label class="form-label">Roles</label>
                        <select name="selectedRoles" class="form-select bg-dark text-light border-secondary" multiple>
                            @foreach (var role in ViewData["Roles"] as List<SelectListItem>)
                            {
                                <option value="@role.Value" selected="@role.Selected">@role.Text</option>
                            }
                        </select>
                    </div>
                }

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-warning px-4">Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2 px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('emailInput')?.addEventListener('input', function () {
            document.getElementById('usernameInput').value = this.value;
        });
    </script>
}

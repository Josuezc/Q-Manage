@model Q_Manage.Models.Pago
@{
    ViewData["Title"] = "Editar Pago";
    var proyecto = ViewBag.Proyecto as Q_Manage.Models.Proyecto;
}

@if (proyecto == null)
{
    <div class="alert alert-danger text-center">
        ❌ Error: El proyecto no existe o no se ha seleccionado correctamente.
    </div>
}
else
{
    <div class="container mt-4 d-flex justify-content-center">
        <div class="card bg-dark text-light p-4 shadow-lg" style="width: 40rem;">
            <div class="card-header text-center">
                <h2>📝 Editar Pago para @proyecto.Nombre</h2>
            </div>

            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProyectoId" value="@proyecto.Id" />

                    <div class="mb-3">
                        <label asp-for="Monto" class="form-label">💵 Monto</label>
                        <input asp-for="Monto" type="number" step="0.01" class="form-control bg-dark text-light border-secondary" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FechaLimite" class="form-label">📅 Fecha Límite</label>
                        <input asp-for="FechaLimite" type="date" class="form-control bg-dark text-light border-secondary" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">📌 Estado de Pago</label>
                        <select asp-for="EstadoPagoId" class="form-select bg-dark text-light border-secondary">
                            @foreach (var estado in ViewBag.EstadosPago)
                            {
                                <option value="@estado.Id" selected="@(Model.EstadoPagoId == estado.Id)">
                                    @estado.Nombre
                                </option>
                            }
                        </select>
                    </div>


                    <div class="text-center">
                        <button type="submit" class="btn btn-warning">💾 Guardar Cambios</button>
                        <a asp-action="Index" asp-route-proyectoId="@proyecto.Id" class="btn btn-secondary">↩️ Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

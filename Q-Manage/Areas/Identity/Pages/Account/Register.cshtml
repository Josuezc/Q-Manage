@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrarse";
}

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="card p-4 shadow-lg rounded-4" style="width: 400px; background: linear-gradient(to right, #2a5298, #1e3c72); color: white;">
        <div class="text-center">
            <h2 class="fw-bold">📝 Crear Cuenta</h2>
            <hr class="bg-light" />
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger text-center" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control bg-light text-dark" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label text-dark">Correo Electrónico</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" type="password" class="form-control bg-light text-dark" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password" class="form-label text-dark">Contraseña</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control bg-light text-dark" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword" class="form-label text-dark">Confirmar Contraseña</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-light text-dark fw-bold shadow">Registrarse</button>
        </form>

        <div class="mt-3 text-center">
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-light">🔑 ¿Ya tienes cuenta? Iniciar sesión</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    body {
        background: linear-gradient(to right, #141e30, #243b55);
    }

    .card {
        animation: fadeIn 1s ease-in-out;
    }

    .btn-light:hover {
        background-color: #f8f9fa;
        color: #1e3c72;
        transform: scale(1.05);
        transition: all 0.3s ease-in-out;
    }

    
</style>
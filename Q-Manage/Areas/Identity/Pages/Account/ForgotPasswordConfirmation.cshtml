@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<h1>@ViewData["Title"]</h1>
<p>
    Please check your email to reset your password.
    <div class="d-flex justify-content-center align-items-center min-vh-100">
        <div class="card p-4 shadow-lg rounded-4 text-center" style="width: 400px;">
            <h2 class="text-primary fw-bold">📩 Correo Enviado</h2>
            <p>Si tu correo está registrado, recibirás un enlace para restablecer tu contraseña.</p>
            <p>Por favor, revisa tu bandeja de entrada y sigue las instrucciones.</p>

            <a class="btn btn-success w-100 mt-3" asp-page="./Login">🔑 Volver al Login</a>

            <!-- ⚠️ Botón solo para pruebas (NO USAR EN PRODUCCIÓN) -->
            <a class="btn btn-warning w-100 mt-2" asp-page="./ResetPassword" asp-route-token="prueba123">
                🔧 Ir a Reset Password (Solo pruebas)
            </a>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</p>
